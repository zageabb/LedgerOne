FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///ledgerone.db

LEDGERONE_ADMIN_EMAIL=admin@ledgerone.local
LEDGERONE_ADMIN_PASSWORD=change-me-now
LEDGERONE_ADMIN_NAME=LedgerOne Administrator
LEDGERONE_ORG_NAME=My Ledger

# Development/local installs can create a new schema automatically.
# Production should normally set AUTO_CREATE_SCHEMA=false and run
# `flask --app run.py db upgrade` before starting LedgerOne.
AUTO_CREATE_SCHEMA=true
AUTO_SEED_DEFAULTS=true

LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen3:14b
LOCAL_AI_TIMEOUT=120
LOCAL_AI_ALLOW_WRITES=true

# Supporting files are stored outside the accounting database.
# Default is ./data/documents when omitted.
LEDGERONE_DOCUMENT_STORAGE_DIR=./data/documents
LEDGERONE_DOCUMENT_MAX_BYTES=26214400
